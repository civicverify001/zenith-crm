{
  "functions": {
    "api/**/*.ts": {
      "runtime": "@vercel/node@5.0.0"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/autopay",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/fulfillment",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/lifecycle",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/sms-reminders",
      "schedule": "*/30 * * * *"
    }
  ]
